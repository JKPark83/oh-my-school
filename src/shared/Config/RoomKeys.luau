--!strict
--[[
	교실 인스턴스에 붙는 이름들. 서버가 붙이고 클라이언트가 찾는다.

	Phase 3까지는 교실이 하나뿐이라 양쪽이 문자열을 각자 적어도 됐다.
	Phase 4에서 교실이 12개가 되면서 클라이언트가 "내 교실"을 찾아야 하고,
	찾는 이름이 어긋나면 화면에 아무것도 안 나오는 침묵하는 버그가 된다.
	그래서 이름은 여기 한 곳에만 적는다.
]]

local RoomKeys = {}

-- 태그(CollectionService)
RoomKeys.SEAT_TAG = "Seat"
RoomKeys.COVER_TAG = "Cover"
RoomKeys.SLIP_TAG = "Slip"

--[[
	카메라와 나 사이를 가로막으면 반투명해지는 파트. 벽·천장 같은 구조물에만 붙는다.

	★ "가리는 것을 전부 지운다"가 아니라 "붙인 것만 지운다"인 이유는 선생님 때문이다.
	  카메라와 나 사이에 든 것을 무조건 투명하게 만들면, 뒤돌아섰을 때 선생님이나
	  옆자리 학생까지 사라진다. 보이면 안 되는 것은 벽이지 사람이 아니다.
]]
RoomKeys.FADE_TAG = "Fade"

-- 교실 모델 안의 자식 이름
RoomKeys.SEATS_FOLDER = "Seats"
RoomKeys.OBSTACLES_FOLDER = "Obstacles"
RoomKeys.TEACHER = "Teacher"

-- 어트리뷰트
RoomKeys.EMPTY_ATTRIBUTE = "IsEmpty" -- 좌석에 붙는다. 서버만 쓴다
RoomKeys.OBSTACLES_ATTRIBUTE = "ObstaclesActive" -- 교실 모델에 붙는다

--[[
	내 자리. 빈자리가 1~2개인데 그중 하나에만 붙는다.

	★ 빈자리(IsEmpty)와 따로 두는 이유는 나머지 빈자리가 함정이기 때문이다.
	  아무 빈자리나 정답이면 플레이어는 늘 문에서 가장 가까운 자리로 간다 —
	  교실 하나가 문제 하나가 된다. 앉을 자리를 지정하면 같은 교실이
	  좌석 수만큼의 서로 다른 문제가 된다. 창가 앞자리는 선생님 코앞을 지나야 하고,
	  복도 뒷자리는 멀지만 어둡다.

	★ 클라이언트가 읽는다. 위조해봐야 자기 화면의 표시만 바뀐다 —
	  실제 판정은 서버가 자기 세션의 seat 참조로 직접 비교한다.
]]
RoomKeys.ASSIGNED_ATTRIBUTE = "IsMine"

--[[
	이 자리 학생이 바라보는 방향(도). 0 이면 칠판을 본다 — 대부분의 학생이 그렇다.
	0 이 아니면 고자질하는 학생이다: 90/-90 은 옆 분단, 180 은 뒤를 돌아본 자세다.

	★ 방향 하나로 "고자질하는 애인가"까지 같이 말한다. 따로 불리언을 두면
	  "옆을 보는데 고자질은 안 하는 애"와 "칠판을 보는데 고자질하는 애"라는,
	  화면에 보이는 것과 규칙이 어긋난 상태가 만들어질 수 있다.
	  보이는 것이 곧 규칙이어야 억울함이 안 생긴다.

	★ 판정은 서버가 세션에 들고 있는 목록으로 한다. 이건 그리기용이다.
]]
RoomKeys.FACING_ATTRIBUTE = "Facing"

--[[
	이 자리 학생이 손을 들고 있는가. 서버가 켜고 끈다.

	고자질하는 학생이 나를 봤다는 신호다. 손이 올라간 뒤 유예 시간 안에
	시야에서 벗어나면 다시 내려간다 — 손드는 동안은 아직 아무 일도 안 일어났다.
]]
RoomKeys.RAISED_ATTRIBUTE = "HandRaised"

--[[
	이 교실이 지금 몇 학년인가. 교실 모델에 붙는다. 서버가 반을 열 때 정한다.

	★ 클라이언트가 학생 체구를 정하는 데 쓴다. 1학년 아이와 6학년 아이가 같은 크기면
	  교실만 색이 바뀌고 앉아 있는 아이들은 그대로라 학년이 반쯤만 보인다.

	★ 프로필(ProfileUpdated)로도 학년이 내려가지만 그걸 쓰지 않는다. 학생 렌더는
	  "내 교실"에 매여 있는데 프로필은 플레이어에 매여 있어서, 둘의 도착 순서가
	  어긋나면 전 학년 체구로 한 반을 통째로 그린다. 교실에 붙어 있는 값이
	  교실을 그리는 유일한 근거여야 한다.
]]
RoomKeys.GRADE_ATTRIBUTE = "Grade"

-- 좌석의 교실 안 위치. 분단은 창가 쪽이 1, 번째는 칠판 쪽이 1이다.
-- HUD 가 "1분단 3번째"로 읽는 값이라 서버가 지을 때 한 번만 박아둔다.
RoomKeys.COLUMN_ATTRIBUTE = "Column"
RoomKeys.ROW_ATTRIBUTE = "Row"

-- Player 아래에 놓이는 ObjectValue. 클라이언트가 자기 교실을 찾는 유일한 경로다.
RoomKeys.ROOM_REF = "Room"

-- 운동장 허브(Phase 5). 교실과 달리 하나뿐이라 이름으로 바로 찾는다.
RoomKeys.HUB = "Playground"

return RoomKeys
